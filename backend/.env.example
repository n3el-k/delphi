# Copy to .env and fill in. Never commit .env.
DATABASE_URL=sqlite:///./app.db
FRONTEND_ORIGIN=http://localhost:5173
# GitHub login of whoever demos: the portfolio links to https://github.com/<login>
DEMO_LEARNER_GITHUB_LOGIN=param-m1
ANTHROPIC_API_KEY=

# GitHub App: ID and installation ID from the App's settings page,
# the path to its downloaded .pem key (keep it outside the repo), and the webhook secret
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Webhook tunnel for local dev (anyone with this URL can see payloads)
SMEE_URL=
